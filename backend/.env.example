# Скопируйте в backend/.env — файл .env в репозиторий не коммитится.
# Переменные читаются модулем app/core/config.py (pydantic-settings).
APP_NAME=ai-for-developers-project-386 API
# JSON-массив origins для CORS (используется, если фронт ходит на API напрямую).
CORS_ORIGINS=["http://localhost:5173"]
