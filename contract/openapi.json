{
  "openapi": "3.0.0",
  "info": {
    "title": "Calendar API",
    "version": "0.0.0"
  },
  "tags": [],
  "paths": {
    "/api/event-types": {
      "get": {
        "operationId": "CalendarApi_listEventTypes",
        "description": "Список типов событий. Гостю — только действующие, владельцу — все.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The request has succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/EventType"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "CalendarApi_createEventType",
        "description": "Создать тип события.",
        "parameters": [],
        "responses": {
          "201": {
            "description": "The request has succeeded and a new resource has been created as a result.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventType"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EventTypeCreate"
              }
            }
          }
        }
      }
    },
    "/api/event-types/{event_type_id}/slots": {
      "get": {
        "operationId": "CalendarApi_listEventTypeSlots",
        "description": "Свободные слоты типа события на календарный день в поясе владельца.\nСлоты идут встык с шагом, равным длительности типа, и не выходят за рабочие часы 09:00–21:00.\nНеизвестный или архивный тип — 404; дата вне окна записи (14 дней от «сегодня») — 400.",
        "parameters": [
          {
            "name": "event_type_id",
            "in": "path",
            "required": true,
            "description": "Идентификатор типа события.",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "date",
            "in": "query",
            "required": true,
            "description": "Календарный день в поясе владельца (YYYY-MM-DD).",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "explode": false
          }
        ],
        "responses": {
          "200": {
            "description": "The request has succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Slot"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "EventType": {
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "duration_minutes",
          "status"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32",
            "description": "Системный идентификатор."
          },
          "name": {
            "type": "string",
            "description": "Название типа события."
          },
          "description": {
            "type": "string",
            "description": "Описание типа события."
          },
          "duration_minutes": {
            "type": "integer",
            "format": "int32",
            "minimum": 5,
            "maximum": 720,
            "description": "Длительность встречи в минутах (5–720)."
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/EventTypeStatus"
              }
            ],
            "description": "Статус типа события."
          }
        },
        "description": "Вид встречи, который заводит владелец."
      },
      "EventTypeCreate": {
        "type": "object",
        "required": [
          "name",
          "description",
          "duration_minutes"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Название типа события."
          },
          "description": {
            "type": "string",
            "description": "Описание типа события."
          },
          "duration_minutes": {
            "type": "integer",
            "format": "int32",
            "minimum": 5,
            "maximum": 720,
            "description": "Длительность встречи в минутах (5–720)."
          }
        },
        "description": "Данные для создания типа события."
      },
      "EventTypeStatus": {
        "type": "string",
        "enum": [
          "active",
          "archived"
        ],
        "description": "Статус типа события: действующий или архивный."
      },
      "Slot": {
        "type": "object",
        "required": [
          "start",
          "end"
        ],
        "properties": {
          "start": {
            "type": "string",
            "format": "date-time",
            "description": "Начало слота в UTC (ISO 8601)."
          },
          "end": {
            "type": "string",
            "format": "date-time",
            "description": "Конец слота в UTC (ISO 8601)."
          }
        },
        "description": "Свободный слот: полуинтервал `[start, end)` времени в UTC."
      }
    }
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8000",
      "description": "Локальный сервер разработки",
      "variables": {}
    }
  ]
}
